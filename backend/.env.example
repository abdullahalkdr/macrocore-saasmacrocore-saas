# macrocore.io Backend Environment Variables

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/macrocore_dev

# Server
PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRY=24h

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:3000,https://macrocore.io

# Admin
ADMIN_EMAIL=admin@macrocore.io
# Shared secret for /api/admin/* (cross-tenant billing views) — send as header X-Admin-Key.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_API_KEY=change_this_to_a_long_random_string

# Google OAuth ("Sign in / up with Google") — OAuth Client ID from Google Cloud Console
# (APIs & Services > Credentials > OAuth client ID > Web application). Must match the
# same value as frontend/.env's VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Email (verification link, password reset, security notices, invitations, approvals)
# — via Resend (resend.com). Get a key from Resend's dashboard and verify the
# "notify.macrocore.io" SENDING SUBDOMAIN there first (not the bare macrocore.io
# domain — see claude/resend-setup-checklist.md), or emails will fail to send. Leave
# RESEND_API_KEY blank for local dev — emails are still durably queued (email_jobs)
# but marked dev_skipped and printed to the backend console instead of actually
# sending, so the whole flow (including retries/admin log) is testable end-to-end
# without a real provider. There is no EMAIL_FROM here — sender identity is
# per-category and decided in code (utils/email.ts's CATEGORY_FROM), not a
# per-deploy env var.
RESEND_API_KEY=
# Verifies inbound Resend/Svix webhook requests (POST /api/webhooks/resend) —
# Resend dashboard → Webhooks → Signing Secret, looks like "whsec_...". Leave blank
# for local dev; the webhook route refuses every request with 503 while unset rather
# than accept an unauthenticated delivery-status update.
RESEND_WEBHOOK_SECRET=
# Base URL of the dashboard (frontend) — used to build the links inside verification/
# reset emails, e.g. FRONTEND_URL/reset-password?token=...
FRONTEND_URL=https://app.macrocore.io

# GLOBAL UNLOCK — DEV/TEST ONLY. Set to 'true' to suspend the Bronze/Silver/Gold plan
# tier system entirely: every company behaves as if it were on the ultimate tier
# (no locked nav items, no 403 PLAN_UPGRADE_REQUIRED, no Bronze location cap), and
# Maker-Checker approval becomes mandatory for Payroll/Purchase Orders/Expenses on
# every company instead of Gold+ only. Does NOT touch the DB schema or any company's
# stored plan value — purely a runtime bypass. NEVER set this to 'true' in a
# production environment serving real paying customers; leave blank/false there.
BYPASS_PLAN_GATING=
